<!--
  app-control block: this app handles VIEW operations for the `myapp` URI
  scheme and any application/json payload.

  Merge into tizen/tizen-manifest.xml under <ui-application>.
-->
<app-control>
  <operation name="http://tizen.org/appcontrol/operation/view"/>
  <uri name="myapp"/>
  <mime name="application/json"/>
</app-control>

<!-- For sendTerminateRequest() on another app: -->
<privileges>
  <privilege>http://tizen.org/privilege/appmanager.kill.bgapp</privilege>
</privileges>
