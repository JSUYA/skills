<!--
  Service app declaration. Place in the service's tizen-manifest.xml.
-->
<service-application appid="org.example.myapp.service"
                     exec="myapp_service"
                     type="capp"
                     multiple="false"
                     on-boot="false"
                     auto-restart="false">
  <label>MyApp Service</label>
  <icon>default.png</icon>
</service-application>

<privileges>
  <privilege>http://tizen.org/privilege/messageport</privilege>
  <privilege>http://tizen.org/privilege/appmanager.launch</privilege>
</privileges>
